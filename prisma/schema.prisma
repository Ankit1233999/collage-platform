generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String   @id @default(cuid())
  email    String   @unique
  password String
}

model College {
  id         String @id @default(cuid())
  name       String
  location   String
  fees       Int
  rating     Float
  placements String
  courses    String
  image      String
  students   Int @default(0)

}
